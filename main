from funciones import convertir_diccio
#(FUNCION API PARA CREAR DICCIONARIOS CON LISTAS PARA POKEMONES)

print("¡Bienvenido al juego de Pokemon!")

lista_totales = []
list_poke = { #ESTA SERIA EL DICCIONARIO CREADO POR LA API
    "Novatos": ["dragonite","tyranitar","metagross","arcanine"],
    "Medios": ["vaporeon","jolteon","pikachu","eevee"],
    "Altos": ["psyduck","charmander","charizard","rattata"] }
for lista in list_poke.values():
    for p in lista:
        lista_totales.append(p)

pares = {
    "ataque": "velocidad",
    "velocidad": "ataque",
    "defensa": "adaptabilidad",
    "adaptabilidad": "defensa"
}
pokemones=convertir_diccio(list_poke)

print("Pokemones: ")
pok_usuario = []
pok_cpu = []
# ELECCION POKEMON USUARIO
for tipo, lista_pokemones in pokemones.items():
    print(tipo)
    for pokemon in lista_pokemones:
        print(pokemon.nombre)
        pokemon.mostrar_atributos() #sale de la calse pokemon 
    poke = input(f"Seleccione pokemon: ").lower()
    while poke not in lista_totales:
            poke = input("Pokemon invalido. \n Seleccione Pokemon de la lista: ")
    print(f"{poke} seleccionado correctamente!")

    pokemon_elegido = None
    for pokemon in lista_pokemones:
        if pokemon.nombre == poke:
            pokemon_elegido = pokemon
            break
            
# USUARIO SELECCIONAR ATRIBUTO A CAMBIAR
    lista_atributos = ["ataque","velocidad","defensa","adaptabilidad" ]
    
    print("Ingrese el atributo a boostear, recuerda que aumentar un atributo disminuye otro.")  
    atributo = input("Ataque \n Adaptabilidad \n Defensa \n Velocidad").lower()
    
    while atributo not in lista_atributos:
        atributo = input("Atributo invalido. \n Seleccione un atributo de la lista: ")
    
    atributo2 = pares[atributo]
    pokemon_elegido.cambiar_atributo(atributo, atributo2, float(0.15))
    pok_usuario.append(pokemon_elegido) #VERIFICAR STRING UNA VEZ Q SE CREE BIEN EL OBJETO

# ELECCION CPU
for categoria, lista_pokemones in pokemones.items():
    num_cpu = random.randint(0, (len(lista_pokemones) -1))
    pokemon_elegido_cpu = lista_pokemones[num_cpu]

# CPU SELECCIONAR ATRIBUTO A CAMBIAR   
    num_att = random.randint(0, (len(lista_atributos)-1))
    #funcion_cambio_atributo(poke_cpu, num_att)
    atributo_cpu = lista_atributos[num_att]
    atributo_cpu2 = pares[atributo_cpu]

    pokemon_elegido_cpu.cambiar_atributo(atributo_cpu, atributo_cpu2, float(0.15))
    pok_cpu.append(pokemon_elegido_cpu)
    
# ELECCION AMBIENTE

lista_ambientes = ["playa", "bosque", "volcan", "tormenta"]

num_amb = random.randint(0, (len(lista_ambientes)-1))
ambiente = lista_ambientes[num_amb]

#TIENEN QUE SER CAMBIADOS A LOS OBJETOS AMBIENTES, NO DEJAR COMO STR
print(f"Ambiente seleccionado al azar: {ambiente}")

