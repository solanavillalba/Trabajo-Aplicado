# aqui llamamos a la API y convertimos cada dato crudo a objeto Pokemon
# asi cada pokemon tiene .tipo, .ataque, .defensa, .speed, .adaptabilidad 
datos_crudos = f.obtener_datos_api()

# aqui organizamos los objetos Pokemon por tipo (agua, fuego, tierra, electricidad)
# y asi el jugador va a elegir un pokemon de cada tipo
pokemones = {"agua": [], "fuego": [], "tierra": [], "electricidad": []}
for dato in datos_crudos:
    pokemon_obj = f.crear_pokemon(dato)              # convierte dato crudo a objeto Pokemon
    pokemones[pokemon_obj.tipo].append(pokemon_obj)  # lo mete en su categoria por tipo

# llamamos a la API de nuevo para tener objetos independientes para la cpu
datos_crudos_cpu = f.obtener_datos_api()
