    poke_nombre = input(f"Selecciona tu pokemon de tipo {tipo}: ").lower().strip()
    while poke_nombre not in nombres_disponibles:
        poke_nombre = input(f"Pokemon invalido. eligr entre {nombres_disponibles}: ").lower().strip()

        #una vez validado el nombre buscamos el objeto Pokemon que le corresponde
    # recorremos lista_pokemones hasta encontrar el que tiene ese nombre

